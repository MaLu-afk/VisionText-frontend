# Imagen de DESARROLLO (servidor de Vite con hot reload). La usa docker-compose en local.
# Producción usa Dockerfile.
FROM node:20-alpine

WORKDIR /app

# Copiar archivos de dependencias
COPY package*.json ./

# Instalar dependencias
RUN npm install

# Copiar código
COPY . .

# Exponer puerto de desarrollo
EXPOSE 5173

# Comando de desarrollo con hot reload
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]